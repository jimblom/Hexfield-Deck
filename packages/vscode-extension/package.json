{
    "name": "hexfield-deck",
    "displayName": "Hexfield Deck",
    "description": "Markdown-powered kanban task board for VS Code",
    "version": "1.0.0",
    "publisher": "jimblom",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jimblom/Hexfield-Deck.git"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "icon": "icon.png",
    "categories": [
        "Productivity",
        "Other"
    ],
    "keywords": [
        "kanban",
        "markdown",
        "task board",
        "planner",
        "productivity"
    ],
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "hexfield-deck.openBoard",
                "title": "Hexfield Deck: Open Board"
            }
        ],
        "configuration": {
            "title": "Hexfield Deck",
            "properties": {
                "hexfield-deck.tagConfig": {
                    "type": "object",
                    "default": {},
                    "description": "Per-tag color configuration. Keys are tag names (without #). Each value may have 'color' (hex string) and 'style' (how the color is applied to cards).",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "color": {
                                "type": "string",
                                "description": "Hex color for tag pill and card accent"
                            },
                            "style": {
                                "type": "string",
                                "enum": ["border", "fill", "both"],
                                "description": "How to apply the color to matching cards (default: border)"
                            }
                        }
                    }
                },
                "hexfield-deck.tagPriorityList": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "description": "Ordered list of tag names. When a card has multiple colored tags, the first tag in this list determines the card's accent color."
                }
            }
        },
        "menus": {
            "explorer/context": [
                {
                    "command": "hexfield-deck.openBoard",
                    "when": "resourceLangId == markdown || resourceLangId == hexfield-markdown",
                    "group": "navigation@10"
                }
            ],
            "editor/title/context": [
                {
                    "command": "hexfield-deck.openBoard",
                    "when": "resourceLangId == markdown || resourceLangId == hexfield-markdown",
                    "group": "navigation@10"
                }
            ]
        }
    },
    "scripts": {
        "build": "pnpm build:extension && pnpm build:webview",
        "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --loader:.css=text",
        "build:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview.js --format=iife --platform=browser --loader:.css=text",
        "watch": "pnpm build --watch",
        "package": "vsce package --no-dependencies"
    },
    "dependencies": {
        "@hexfield-deck/core": "workspace:*",
        "@hexfield-deck/webview-ui": "workspace:*"
    },
    "devDependencies": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@types/vscode": "1.85.0",
        "@vscode/vsce": "3.7.1",
        "esbuild": "0.24.2",
        "typescript": "5.7.3"
    }
}
